{{ define "nfs_quota_root" }}

# Every filesystem is provisioned with a root quota on its mount path;
# test quotas are created on a subpath under it.
data "linode_nfs_quotas" "root" {
    space_id      = {{ .SpaceID }}
    filesystem_id = {{ .FilesystemID }}

    filter = [
        {
            name   = "is_root"
            values = ["true"]
        }
    ]
}

{{ end }}

{{ define "nfs_quota_basic" }}

{{ template "nfs_quota_root" . }}

resource "linode_nfs_quota" "foobar" {
    space_id           = {{ .SpaceID }}
    filesystem_id      = {{ .FilesystemID }}
    path               = "${data.linode_nfs_quotas.root.nfs_quotas[0].path}/{{ .Label }}"
    max_capacity_bytes = 2147483648
    max_file_count     = 2000
}

{{ end }}
