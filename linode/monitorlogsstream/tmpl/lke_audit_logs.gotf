{{ define "monitor_logs_stream_lke_audit_logs" }}

provider "linode" {
  obj_use_temp_keys       = true
  obj_bucket_force_delete = true
}

resource "linode_object_storage_bucket" "foobar" {
  region = "{{.Region}}"
  label  = "{{.Label}}-bucket"
}

resource "linode_object_storage_key" "foobar" {
  label = "{{.Label}}-key"

  bucket_access {
    region      = linode_object_storage_bucket.foobar.region
    bucket_name = linode_object_storage_bucket.foobar.label
    permissions = "read_write"
  }
}

resource "linode_monitor_logs_destination" "foobar" {
  label = "{{.Label}}"
  type  = "akamai_object_storage"

  akamai_object_storage_details = {
    access_key_id     = linode_object_storage_key.foobar.access_key
    access_key_secret = linode_object_storage_key.foobar.secret_key
    bucket_name       = linode_object_storage_bucket.foobar.label
    host              = linode_object_storage_bucket.foobar.hostname
  }
}

resource "linode_monitor_logs_stream" "foobar" {
  label        = "{{.Label}}"
  type         = "lke_audit_logs"
  destinations = [linode_monitor_logs_destination.foobar.id]

  details = {
    cluster_ids                      = [{{.ClusterID}}]
    is_auto_add_all_clusters_enabled = false
  }
}

{{ end }}
