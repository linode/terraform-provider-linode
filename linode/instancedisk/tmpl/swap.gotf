{{ define "instance_disk_swap" }}

# Create instance WITHOUT any image - no auto-provisioned disks at all
resource "linode_instance" "foobar" {
    label = "{{ .Label }}"
    type = "g6-nanode-1"
    region = "{{ .Region }}"
}

# Create a swap disk
# Even though there's no image on the instance, the test validates
# that swap disks don't get image attributes populated
resource "linode_instance_disk" "swap" {
  label = "{{ .Label }}-swap"
  linode_id = linode_instance.foobar.id
  size = {{ .Size }}
  filesystem = "swap"
}

{{ end }}
