{{ define "database_valkey_v2_complex" }}
resource "linode_database_valkey_v2" "foobar" {
  label       = "{{ .Label }}"
  region      = "{{ .Region }}"
  type        = "{{ .Type }}"
  engine_id   = "{{ .EngineID }}"
  allow_list  = [{{ if .AllowedIP }}"{{ .AllowedIP }}"{{ end }}]
  cluster_size = {{ .ClusterSize }}

  updates = {
    hour_of_day = {{ .MaintenanceHour }}
    day_of_week = 2
    frequency   = "weekly"
    duration    = 4
  }
}
{{ end }}

{{ define "database_valkey_v2_suspension" }}
resource "linode_database_valkey_v2" "foobar" {
  label     = "{{ .Label }}"
  region    = "{{ .Region }}"
  type      = "{{ .Type }}"
  engine_id = "{{ .EngineID }}"
  suspended = {{ .Suspended }}
}
{{ end }}

{{ define "database_valkey_v2_engine_config" }}
resource "linode_database_valkey_v2" "foobar" {
  label     = "{{ .Label }}"
  region    = "{{ .Region }}"
  type      = "{{ .Type }}"
  engine_id = "{{ .EngineID }}"

  engine_config_backup_hour = {{ .BackupHour }}
  engine_config_backup_minute = {{ .BackupMinute }}
  engine_config_frequent_snapshots = {{ .FrequentSnapshots }}
  engine_config_valkey_acl_channels_default = "{{ .ACLChannelsDefault }}"
  engine_config_valkey_active_expire_effort = {{ .ActiveExpireEffort }}
  engine_config_valkey_activedefrag = {{ .ActiveDefrag }}
  engine_config_valkey_lfu_decay_time = {{ .LFUDecayTime }}
  engine_config_valkey_lfu_log_factor = {{ .LFULogFactor }}
  engine_config_valkey_number_of_databases = {{ .NumberOfDatabases }}
  engine_config_valkey_persistence = "{{ .Persistence }}"
  engine_config_valkey_pubsub_client_output_buffer_limit = {{ .PubsubClientOutputBufferLimit }}
  engine_config_valkey_timeout = {{ .Timeout }}
  engine_config_valkey_maxmemory_policy = "{{ .MaxmemoryPolicy }}"
}
{{ end }}