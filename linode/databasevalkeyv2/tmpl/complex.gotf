{{ define "database_valkey_v2_complex" }}

resource "linode_database_valkey_v2" "foobar" {
    label = "{{.Label}}"
    region = "{{ .Region }}"
    type = "{{ .Type }}"
    engine_id = "{{ .EngineID }}"

    allow_list = [{{ if .AllowedIP }}"{{ .AllowedIP }}"{{ end }}]
    cluster_size = {{ .ClusterSize }}

    updates = {
        hour_of_day = {{ .Updates.HourOfDay }}
        day_of_week = {{ .Updates.DayOfWeek }}
        frequency = "{{ .Updates.Frequency }}"
        duration = {{ .Updates.Duration }}
    }
}

{{ end }}
