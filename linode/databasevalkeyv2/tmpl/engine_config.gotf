{{ define "database_valkey_v2_engine_config" }}

resource "linode_database_valkey_v2" "foobar" {
    label = "{{.Label}}"
    region = "{{ .Region }}"
    type = "{{ .Type }}"
    engine_id = "{{ .EngineID }}"

    engine_config_backup_hour = {{ .EngineConfigBackupHour }}
    engine_config_backup_minute = {{ .EngineConfigBackupMinute }}
    engine_config_frequent_snapshots = {{ .EngineConfigFrequentSnapshots }}
    engine_config_valkey_acl_channels_default = "{{ .EngineConfigValkeyACLChannelsDefault }}"
    engine_config_valkey_active_expire_effort = {{ .EngineConfigValkeyActiveExpireEffort }}
    engine_config_valkey_activedefrag = {{ .EngineConfigValkeyActiveDefrag }}
    engine_config_valkey_lfu_decay_time = {{ .EngineConfigValkeyLFUDecayTime }}
    engine_config_valkey_lfu_log_factor = {{ .EngineConfigValkeyLFULogFactor }}
    engine_config_valkey_number_of_databases = {{ .EngineConfigValkeyNumberOfDatabases }}
    engine_config_valkey_persistence = "{{ .EngineConfigValkeyPersistence }}"
    engine_config_valkey_pubsub_client_output_buffer_limit = {{ .EngineConfigValkeyPubsubClientOutputBufferLimit }}
    engine_config_valkey_timeout = {{ .EngineConfigValkeyTimeout }}
    engine_config_valkey_maxmemory_policy = "{{ .EngineConfigValkeyMaxmemoryPolicy }}"
}

{{ end }}
