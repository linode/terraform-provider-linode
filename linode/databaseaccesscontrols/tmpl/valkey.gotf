{{ define "database_access_controls_valkey" }}

resource "linode_database_valkey_v2" "foobar" {
    engine_id = "{{.Engine}}"
    label = "{{.Label}}"
    region = "{{ .Region }}"
    type = "g7-dedicated-4-2"
}

resource "linode_database_access_controls" "foobar" {
    database_id = linode_database_valkey_v2.foobar.id
    database_type = "valkey"

    allow_list = [{{ if .AllowedIP }}"{{ .AllowedIP }}"{{ end }}]
}

{{ end }}