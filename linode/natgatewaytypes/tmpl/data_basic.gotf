{{ define "natgateway_types_data_basic" }}

data "linode_natgateway_types" "foobar" {
    filter {
        name = "id"
        values = ["g1-natgateway"]
    }
}

data "linode_natgateway_types" "by_label" {
    filter {
        name = "label"
        values = ["NAT Gateway"]
    }
}

data "linode_natgateway_types" "ordered" {
    order_by = "label"
    order = "asc"
}

{{ end }}

