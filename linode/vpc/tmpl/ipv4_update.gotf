{{ define "vpc_ipv4_update" }}

resource "linode_vpc" "foobar" {
    label = "{{.Label}}"
    region = "{{.Region}}"
    description = "some description"

    ipv4 = [
        {
            range = "{{.IPv4Range}}"
        },
        {
            range = "{{.IPv4Range2}}"
        }
    ]
}

{{ end }}

