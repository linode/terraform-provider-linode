{{ define "instance_config_legacy_with_interface" }}

resource "linode_instance" "foobar" {
    label  = "{{ .Label }}"
    type   = "g6-nanode-1"
    region = "{{ .Region }}"
}

{{ template "instance_config_disk" . }}

resource "linode_instance_config" "foobar" {
  linode_id = linode_instance.foobar.id
  label = "my-config"

  device {
    device_name = "sda"
    disk_id = linode_instance_disk.foobar.id
  }

  interface {
    purpose = "public"
  }

  kernel = "linode/grub2"
  root_device = "/dev/sda"
}

{{ end }}
