{{ define "lke_cluster_data_enterprise_vxlan" }}

resource "linode_lke_cluster" "test" {
    label       = "{{ .Label }}"
    region      = "{{ .Region }}"
    k8s_version = "{{ .K8sVersion }}"
    tags        = ["test"]
    tier = "enterprise"

    networking {
        routing_mode = "vxlan"
    }

    pool {
        type  = "g6-standard-1"
        count = 1
        tags  = ["test"]
    }
}

data "linode_lke_cluster" "test" {
    id = linode_lke_cluster.test.id
}

{{ end }}
