{{ define "lke_cluster_enterprise_vpc_only" }}

resource "linode_vpc" "foobar" {
    label = "{{.Label}}"
    region = "{{.Region}}"
    description = "some description"

    ipv4 = [
        {
            range = "{{ .VPCIPv4Range }}"
        }
    ]

    ipv6 = [
        {
            range = "/52"
        }
    ]
}

resource "linode_lke_cluster" "test" {
    label       = "{{ .Label }}"
    region      = "{{ .Region }}"
    k8s_version = "{{ .K8sVersion }}"
    tags        = ["test"]
    tier = "enterprise"
    vpc_id = linode_vpc.foobar.id
    stack_type = "ipv4"

    {{ if .RoutingMode }}
    networking {
        routing_mode = "{{ .RoutingMode }}"
    }
    {{ end }}

    pool {
        type  = "g6-standard-1"
        count = 1
        tags  = ["test"]
    }
}

{{ end }}
