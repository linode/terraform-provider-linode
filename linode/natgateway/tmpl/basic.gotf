{{ define "natgateway_basic" }}

{{ template "e2e_test_firewall" . }}

resource "linode_networking_ip" "reserved_1" {
    type = "ipv4"
    region = "{{ .Region }}"
    public = true
    reserved = true
}

resource "linode_networking_ip" "reserved_2" {
    type = "ipv4"
    region = "{{ .Region }}"
    public = true
    reserved = true
}

resource "linode_networking_ip" "reserved_3" {
    type = "ipv4"
    region = "{{ .Region }}"
    public = true
    reserved = true
}

resource "linode_natgateway" "explicit_autoscaling_true" {
    label = "{{ .Label }}-autoscaling-true"
    region = "{{ .Region }}"
    default_ports_per_interface = 4096
    use_autoscaling = true
{{- if .AutoscaleAddress }}
    addresses = [
        { address = linode_networking_ip.reserved_1.address },
    ]
{{- end }}
}

resource "linode_natgateway" "explicit_autoscaling_false" {
    label = "{{ .Label }}-autoscaling-false"
    region = "{{ .Region }}"
    default_ports_per_interface = 4096
    use_autoscaling = false
    addresses = [
        { address = linode_networking_ip.{{ if .UseSwapAddress }}reserved_3{{ else }}reserved_1{{ end }}.address },
    ]
}

resource "linode_natgateway" "default_empty_addresses" {
    label = "{{ .Label }}-default-empty"
    region = "{{ .Region }}"
    default_ports_per_interface = 4096
}

resource "linode_natgateway" "default_populated_addresses" {
    label = "{{ .Label }}-default-populated"
    region = "{{ .Region }}"
    default_ports_per_interface = 4096
    addresses = [
        { address = linode_networking_ip.reserved_2.address },
    ]
}

{{ end }}
