{{ define "natgateway_complex" }}

resource "linode_vpc" "foobar" {
    label = "{{ .Label }}"
    region = "{{ .Region }}"
}

resource "linode_vpc_subnet" "foobar" {
    vpc_id = linode_vpc.foobar.id
    label = "{{ .Label }}"
    ipv4 = "10.0.0.0/24"
}

resource "linode_networking_ip" "reserved_1" {
    type = "ipv4"
    region = "{{ .Region }}"
    public = true
    reserved = true
}

resource "linode_natgateway" "complex" {
    label = "{{ .Label }}-complex"
    region = "{{ .Region }}"
    default_ports_per_interface = 4096
    use_autoscaling = false
    vpc_subnet_id = linode_vpc_subnet.foobar.id
    addresses = [
        { address = linode_networking_ip.reserved_1.address },
    ]
}

{{ end }}

