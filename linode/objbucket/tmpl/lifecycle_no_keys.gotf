{{ define "object_bucket_lifecycle_no_keys" }}

resource "linode_object_storage_bucket" "foobar" {
    region = "{{.Region}}"
    label = "{{.Label}}"

    lifecycle_rule {
        id = "test-rule"
        prefix = "tf"
        enabled = true

        abort_incomplete_multipart_upload_days = 5

        expiration {
            date = "2021-06-21"
        }
    }
}

{{ end }}

