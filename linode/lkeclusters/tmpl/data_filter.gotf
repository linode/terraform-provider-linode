{{ define "lke_clusters_data_filter" }}

{{ template "lke_clusters_data_base" . }}

data "linode_lke_clusters" "test" {
    depends_on = [linode_lke_cluster.test, linode_lke_cluster.test2]
    filter {
        name = "label"
        values = ["{{.Label}}"]
    }

    filter {
        name = "tier"
        values = ["standard"]
    }
}

data "linode_lke_clusters" "test_tags" {
    depends_on = [linode_lke_cluster.test, linode_lke_cluster.test2]

    filter {
        name   = "tags"
        values = ["{{.Tag2Name}}"]
    }
}

{{ end }}