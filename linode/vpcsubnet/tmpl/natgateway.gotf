{{ define "vpc_subnet_natgateway" }}

resource "linode_vpc" "foobar" {
    label = "{{.Label}}"
    region = "{{.Region}}"
}

resource "linode_natgateway" "first" {
    label = "{{.Label}}-first"
    region = "{{.Region}}"
    default_ports_per_interface = 4096
    use_autoscaling = true
}

resource "linode_natgateway" "second" {
    label = "{{.Label}}-second"
    region = "{{.Region}}"
    default_ports_per_interface = 4096
    use_autoscaling = true
}

resource "linode_vpc_subnet" "foobar" {
    vpc_id = linode_vpc.foobar.id
    label = "{{.Label}}"
    ipv4 = "{{.IPv4}}"
{{- if eq .NATGatewayRef "first" }}
    natgateway_id = linode_natgateway.first.id
{{- else if eq .NATGatewayRef "second" }}
    natgateway_id = linode_natgateway.second.id
{{- else if eq .NATGatewayRef "null" }}
    natgateway_id = null
{{- end }}
}

{{ end }}

