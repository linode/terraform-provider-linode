{{ define "monitor_logs_destination_custom_https_invalid_auth_type" }}

resource "linode_monitor_logs_destination" "foobar" {
  label = "{{.Label}}"
  type  = "custom_https"

  custom_https_details = {
    endpoint_url     = "https://example.com"
    content_type     = "application/json"
    data_compression = "gzip"

    authentication = {
      type = "bearer"
    }
  }
}

{{ end }}

{{ define "monitor_logs_destination_custom_https_missing_auth" }}

resource "linode_monitor_logs_destination" "foobar" {
  label = "{{.Label}}"
  type  = "custom_https"

  custom_https_details = {
    endpoint_url     = "https://example.com"
    content_type     = "application/json"
    data_compression = "gzip"
  }
}

{{ end }}

{{ define "monitor_logs_destination_custom_https_missing_data_compression" }}

resource "linode_monitor_logs_destination" "foobar" {
  label = "{{.Label}}"
  type  = "custom_https"

  custom_https_details = {
    endpoint_url = "https://example.com"
    content_type = "application/json"

    authentication = {
      type = "none"
    }
  }
}

{{ end }}

{{ define "monitor_logs_destination_custom_https_invalid_content_type" }}

resource "linode_monitor_logs_destination" "foobar" {
  label = "{{.Label}}"
  type  = "custom_https"

  custom_https_details = {
    endpoint_url     = "https://example.com"
    content_type     = "text/plain"
    data_compression = "gzip"

    authentication = {
      type = "none"
    }
  }
}

{{ end }}
