{{ define "monitor_logs_destination_traffic_peak_data_basic" }}

resource "linode_monitor_logs_destination" "foobar" {
  label = "{{.Label}}"
  type  = "traffic_peak"

  traffic_peak_details = {
    endpoint_url     = "{{.EndpointURL}}"
    content_type     = "application/json"
    data_compression = "gzip"

    authentication = {
      type     = "basic"
      username = "{{.Username}}"
      password = "{{.Password}}"
    }
  }
}

data "linode_monitor_logs_destination" "foobar" {
  id = linode_monitor_logs_destination.foobar.id
}

{{ end }}

{{ define "monitor_logs_destination_traffic_peak_data_no_auth_type" }}

resource "linode_monitor_logs_destination" "foobar" {
  label = "{{.Label}}"
  type  = "traffic_peak"

  traffic_peak_details = {
    endpoint_url     = "{{.EndpointURL}}"
    content_type     = "application/json"
    data_compression = "gzip"

    authentication = {
      username = "{{.Username}}"
      password = "{{.Password}}"
    }
  }
}

data "linode_monitor_logs_destination" "foobar" {
  id = linode_monitor_logs_destination.foobar.id
}

{{ end }}
