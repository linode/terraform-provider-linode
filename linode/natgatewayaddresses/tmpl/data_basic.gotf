{{ define "natgatewayaddresses_data_basic" }}

resource "linode_networking_ip" "reserved" {
    type = "ipv4"
    region = "{{ .Region }}"
    public = true
    reserved = true
}

resource "linode_natgateway" "foobar" {
    label = "{{ .Label }}"
    region = "{{ .Region }}"
    default_ports_per_interface = 4096
    use_autoscaling = false
    addresses = [
        { address = linode_networking_ip.reserved.address },
    ]
}

data "linode_natgateway_addresses" "foobar" {
    natgateway_id = linode_natgateway.foobar.id

    filter {
        name = "address"
        values = [linode_networking_ip.reserved.address]
    }
}

{{ end }}

