{{ define "instance_type_change_disk" }}

{{ template "e2e_test_firewall" . }}

resource "linode_instance" "foobar" {
    label = "{{.Label}}"

    type = "{{.Type}}"
    region = "{{ .Region }}"
    image = "{{.Image}}"
    root_pass = "{{ .RootPass }}"
    resize_disk = true
    firewall_id = linode_firewall.e2e_test_firewall.id
}

{{ end }}