{{ define "instance_type_change_disk_none" }}

{{ template "e2e_test_firewall" . }}

resource "linode_instance" "foobar" {
    label = "{{.Label}}"

    type = "{{.Type}}"
    region = "{{ .Region }}"

    {{ if .ResizeDisk }} resize_disk = {{.ResizeDisk}} {{ end }}

    firewall_id = linode_firewall.e2e_test_firewall.id
}

{{ end }}